def get_prices(symbols):
    """获取价格 - 修复版"""
    prices = {}
    for s in symbols:
        try:
            resp = requests.get("https://api.binance.com/api/v3/ticker/price",
                              params={"symbol": f"{s}USDT"},
                              proxies=PROXIES, timeout=10)
            if resp.status_code == 200:
                prices[s] = float(resp.json()["price"])
        except:
            pass
    return prices

# ====================
# 加权决策等式 v2.0 (2026-05-04)
# ====================
def weighted_decision_v2(price_change_pct, cost_diff_pct, volatility, mirofish_score):
    """
    D = α(P_change) + β(P_cost_diff) + γ(trend) + δ(volatility) + ε(Mirofish)
    阈值: |D| > 0.5 触发交易
    """
    α, β, γ, δ, ε = 0.25, 0.20, 0.15, 0.15, 0.25
    D = (α * price_change_pct / 100 + β * cost_diff_pct + γ * mirofish_score + δ * volatility + ε * mirofish_score)
    return D

def mirofish_1000_agents(base_direction="sideways", base_confidence=0.5):
    """
    运行1000智能体Mirofish仿真
    """
    import random
    votes = {"bull": 0, "bear": 0, "sideways": 0, "uncertain": 0}
    for i in range(1000):
        noise = random.gauss(0, 0.3)
        if base_direction == "bull":
            signal = 1.0 + noise
        elif base_direction == "bear":
            signal = -1.0 + noise
        elif base_direction == "sideways":
            signal = noise
        else:
            signal = random.choice([-1, 0, 1]) + noise
        if signal > 0.3:
            votes["bull"] += 1
        elif signal < -0.3:
            votes["bear"] += 1
        elif abs(signal) <= 0.3:
            votes["sideways"] += 1
        else:
            votes["uncertain"] += 1
    total = sum(votes.values())
    mirofish_score = (votes["bull"] - votes["bear"]) / total * base_confidence
    return votes, mirofish_score

if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    main_loop()
